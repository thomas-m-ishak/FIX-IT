@model IEnumerable<FIX_IT.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-primary"><i class="bi bi-people"></i> Users List</h2>
        <a asp-action="Create" asp-controller="Users" class="btn btn-success">
            Add New User
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Username</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th class="text-center">Role</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Username</td>
                            <td>@item.Email</td>
                            <td>@item.PhoneNumber</td>
                            <td class="text-center">
                                @if (item.IsAdmin)
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">User</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group">
                                    <a asp-action="Edit" asp-controller="Users" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Edit</a>
                                    <a asp-action="Details" asp-controller="Users" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary mx-1">Details</a>
                                    <a asp-action="Delete" asp-controller="Users" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
