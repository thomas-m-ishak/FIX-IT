@model FIX_IT.Models.Booking

@{
    ViewData["Title"] = "Rate Our Service";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 shadow-lg border-0 text-center">
                <i class="bi bi-check-circle-fill text-success mb-3" style="font-size: 4rem;"></i>
                <h2 class="fw-bold mb-4">Payment Successful!</h2>
                <p class="lead">How was your experience with us?</p>

                <form asp-action="Feedback" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3 text-start">
                        <label class="form-label fw-bold">Your Rating:</label>
                        <select name="Rating" class="form-select form-select-lg">
                            <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                            <option value="4">⭐⭐⭐⭐ Very Good</option>
                            <option value="3">⭐⭐⭐ Good</option>
                        </select>
                    </div>

                    <div class="mb-4 text-start">
                        <label class="form-label fw-bold">Comments:</label>
                        <textarea name="Feedback" class="form-control" rows="3" placeholder="Tell us more..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">Submit & Finish</button>
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Go to Home Page</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
